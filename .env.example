# Copy this to .env.local for local dev (`vercel env pull .env.local` will
# generate it automatically once these are set in your Vercel project).

# Anthropic API key — console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Vercel Postgres — created automatically when you add the Postgres
# integration to your Vercel project (Storage tab → Create Database →
# Postgres). Vercel injects POSTGRES_URL and friends for you; you shouldn't
# need to set these by hand except for local dev via `vercel env pull`.
POSTGRES_URL=

# Vercel Blob — created the same way (Storage tab → Create Database → Blob).
BLOB_READ_WRITE_TOKEN=

# A shared passphrase that gates the whole app and every API call. Pick
# something only the family knows. Leave unset to run without a gate
# (fine for local dev, not recommended once deployed publicly).
APP_PASSPHRASE=
